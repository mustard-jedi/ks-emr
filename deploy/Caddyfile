# Caddy configuration for KS EMR: automatic HTTPS in front of the app.
#
# 1. Point your domain's DNS A/AAAA record at this server and open ports 80 and 443.
# 2. Replace emr.example.com below with your domain.
# 3. sudo cp deploy/Caddyfile /etc/caddy/Caddyfile && sudo systemctl reload caddy
#
# Caddy gets and renews the Let's Encrypt certificate by itself.

emr.example.com {
	encode zstd gzip

	# Uploads are limited to 25 MB by the app; allow a little headroom.
	request_body {
		max_size 32MB
	}

	reverse_proxy 127.0.0.1:4700

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Robots-Tag "noindex, nofollow"
		-Server
	}

	log {
		output file /var/log/caddy/ks-emr.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
