# Settings for one KS EMR install. Copy to .env and adjust; deploy/install.sh writes this file for you.
# Every install (for example a production one and a development one on the same machine) has its own .env.

# Port the app listens on. Give each install on a machine a different port.
PORT=4700
# Listen on this machine only; a proxy (Caddy, Tailscale Serve) provides HTTPS in front.
HOST=127.0.0.1
# Where the database and uploaded files live.
KS_DATA_DIR=./data
# The address people type in the browser. Used in physician share links.
KS_PUBLIC_URL=https://emr.example.com
# production = sign-in cookies are HTTPS-only (except when opened as http://localhost on this machine).
NODE_ENV=production
# Wall-clock timezone for medication schedules and "now" defaults.
TZ=America/New_York

# Optional. A short label shown in the title bar, to mark an install that does NOT hold real records.
# KS_ENV_LABEL=DEV - demo data
# Optional. Name of the PM2 process, if you run more than one install under PM2 on this machine.
# KS_PM2_NAME=ks-emr
# Optional. Sign-in cookie name. Default: ks_session_<PORT>, so installs on one machine stay signed in separately.
# KS_COOKIE_NAME=ks_session
