# Copy to .env and adjust. All values are optional except KS_PUBLIC_URL in production.
PORT=4700
# Listen on localhost only; Caddy (or your own proxy) terminates HTTPS in front.
HOST=127.0.0.1
# Where the database and attachments live.
KS_DATA_DIR=./data
# The public address people type in the browser. Used in physician share links.
KS_PUBLIC_URL=https://emr.example.com
# Set to production on the server so cookies are HTTPS-only.
NODE_ENV=production
# Wall-clock timezone for medication schedules and "now" defaults.
TZ=America/New_York
